# ==============================================================================
# Multi-Tenant B2B SaaS - Git Ignore Configuration
# ==============================================================================

# Hassas Ortam Değişkenleri ve Gizli Anahtarlar (GÜVENLİK)
.env
*.env
.env.*
!.env.example

# Bağımlılıklar
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Yerel Veritabanı ve Log Dosyaları
*.db
*.db-journal
dev.db
prisma/pgdata/
*.log

# Yüklenen Geçici Dosyalar
uploads/*
!uploads/.gitkeep

# İşletim Sistemi ve IDE Dosyaları
.DS_Store
Thumbs.db
.vscode/
.idea/
