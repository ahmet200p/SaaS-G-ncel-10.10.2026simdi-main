# ==============================================================================
# Multi-Tenant B2B SaaS - Örnek Ortam Değişkenleri (.env.example)
# Bu dosyayı .env olarak kopyalayın ve kendi benzersiz gizli anahtarlarınızı girin.
# UYARI: Asla gerçek üretim şifrelerini veya anahtarlarını bu dosyaya yazmayın!
# ==============================================================================

# Sunucu Yapılandırması
PORT=5000
NODE_ENV=development

# PostgreSQL Veritabanı Yapılandırması (Docker Compose ile Birebir Uyumlu)
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=saas_db
DATABASE_URL="postgresql://saas_admin:your_secure_postgres_password_here@localhost:5432/saas_db?schema=public"

# JSON Web Token (JWT) Gizli Anahtarı ve Süresi
# GÜVENLİK: Üretim ortamında en az 32 karakterli güçlü ve rastgele bir anahtar belirleyin.
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d

# Başlangıç Hesap Parolaları (.env içinde mutlaka güçlü bir değer tanımlanmalıdır, aksi halde sistem başlamaz)
DEFAULT_ADMIN_PASSWORD=your_super_strong_admin_password_here
DEFAULT_DEALER_PASSWORD=your_super_strong_dealer_password_here
DEFAULT_CUSTOMER_PASSWORD=your_super_strong_customer_password_here
